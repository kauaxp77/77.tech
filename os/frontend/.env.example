# Variáveis do frontend do 77xp OS. Tudo aqui vai para dentro do JavaScript que o
# navegador baixa: NUNCA coloque segredo neste arquivo nem em nenhuma variável VITE_*.

# Endereço da API. No ambiente local, o docker compose já define este valor.
VITE_API_URL=http://localhost:8080/api/v1

# --- Só para o e2e (npm run e2e), no computador. Nada disto vai para produção. ---
# Onde as telas, a API e o servidor de e-mail respondem.
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8080/api/v1
MAILPIT_URL=http://localhost:8025
# O mesmo e-mail passado em BOOTSTRAP_OWNER_EMAIL ao subir a API.
E2E_OWNER_EMAIL=dono@77xp.local
# Só se o Chromium já estiver instalado noutro lugar (CI, containers).
# E2E_CHROMIUM_PATH=/opt/pw-browsers/chromium
